# PayPal sandbox app. Dashboard → Apps & Credentials → Sandbox.
# The client id is public (the browser button needs it). The secret stays on the server.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Hosted chat model with tool calling. The base URL must end in /v1.
# Do not point this at local Ollama.
#
# Groq has a free key at https://console.groq.com/keys
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#
# OpenAI, if you already have a key:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

